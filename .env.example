# Copie este arquivo para ".env" e preencha. O .env NÃO vai para o GitHub.

# API dos relatos (CRUD).
#  - Local: rode "npm run api" (json-server, porta 3001)
#  - Na nuvem: crie o recurso "relatos" no https://mockapi.io e cole a URL base aqui
#    (ex.: https://6720abcd1234.mockapi.io/api/v1)
VITE_API_URL=http://localhost:3001

# Canal do ThingSpeak onde o ESP32 publica (deixe vazio para usar dados de demonstração)
VITE_THINGSPEAK_CHANNEL_ID=3584820
# Read API Key: só se o canal for privado
VITE_THINGSPEAK_READ_KEY=

# Nome que aparece no topo da página
VITE_LOCAL=Rio de Janeiro
